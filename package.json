{
  "name": "micknorj.tools-mtcord",
  "private": true,
  "version": "0.1.1",
  "description": "A browser extension for managing Discord messages.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.*",
    "build": "npm run typecheck && node scripts/build.mjs",
    "check": "npm test && npm run audit:prod",
    "package": "npm run check && npm run build && node scripts/package.mjs && npm run verify:packages",
    "verify:packages": "node scripts/verify-packages.mjs",
    "audit:prod": "npm audit --omit=dev"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.32",
    "@types/chrome": "^0.0.327",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
